# Base URL of your Youtarr instance, including the port if needed.
YOUTARR_URL=http://youtarr.example.com:3011

# Preferred for automation: an existing Youtarr browser session token.
# If set, username and password are not required.
YOUTARR_TOKEN=

# Otherwise set both values. The server logs in via POST /auth/login and sends
# the returned session token as x-access-token on API requests.
YOUTARR_USERNAME=
YOUTARR_PASSWORD=
